# Production configuration for shared hosting.
# Copy to ".env.prod.local" at the project root (git-ignored), fill in, then run bin/build-release:
# the values are compiled into ".env.local.php", which is uploaded with the release.

APP_ENV=prod
APP_DEBUG=0
# Random 32+ character secret: php -r 'echo bin2hex(random_bytes(32)), "\n";'
APP_SECRET=

# Public URL of the site (used in e-mail links).
DEFAULT_URI=https://www.example.com

# Database given by the host. Set serverVersion to the real MySQL/MariaDB version
# (phpMyAdmin shows it), e.g. 8.0.36 or 10.11.6-MariaDB.
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DBNAME?serverVersion=8.0.36&charset=utf8mb4"

# Mailbox of the hosting offer (URL-encode the "@" of the login as %40).
#   OVHcloud: smtp://contact%40example.com:PASSWORD@ssl0.ovh.net:465
#   IONOS:    smtp://contact%40example.com:PASSWORD@smtp.ionos.fr:465
MAILER_DSN=
MAILER_FROM="monStudio <contact@example.com>"

# No permanent worker on shared hosting: send queued e-mails right after each response.
MESSENGER_CONSUME_ON_TERMINATE=1

# Only if HTTPS is not detected behind the host's load balancer (wrong http:// links):
# TRUSTED_PROXIES=REMOTE_ADDR
