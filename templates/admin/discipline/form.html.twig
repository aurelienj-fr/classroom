{% extends 'base.html.twig' %}

{% block title %}{{ discipline.id ? 'admin.discipline.edit_title'|trans ~ ' — ' ~ discipline.name : 'admin.discipline.new'|trans }}{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="ms-card p-4 p-lg-5">
                <h1 class="h3 mb-4">{{ discipline.id ? 'admin.discipline.edit_title'|trans : 'admin.discipline.new'|trans }}</h1>
                {{ form_start(form) }}
                    {{ form_rest(form) }}
                    <p class="small text-body-secondary"><a href="https://fontawesome.com/search?ic=free" target="_blank" rel="noopener noreferrer">{{ 'admin.discipline.icon_catalog'|trans }}</a></p>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">{{ 'common.save'|trans }}</button>
                        <a href="{{ path('app_admin_discipline_index') }}" class="btn btn-link">{{ 'common.cancel'|trans }}</a>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}
