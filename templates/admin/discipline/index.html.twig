{% extends 'base.html.twig' %}

{% block title %}Disciplines{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h2 mb-0">Disciplines</h1>
        <a href="{{ path('app_admin_discipline_new') }}" class="btn btn-primary"><i class="fa-solid fa-plus me-1" aria-hidden="true"></i>Nouvelle discipline</a>
    </div>
    <div class="ms-card overflow-hidden">
        <table class="table align-middle mb-0">
            <thead>
                <tr class="small text-body-secondary">
                    <th scope="col" class="ps-4">Icône</th>
                    <th scope="col">Nom</th>
                    <th scope="col">Slug</th>
                    <th scope="col"><span class="visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                {% for discipline in disciplines %}
                    <tr>
                        <td class="ps-4"><i class="fa-solid fa-{{ discipline.icon }} text-primary" aria-hidden="true"></i></td>
                        <td>{{ discipline.name }}</td>
                        <td><code>{{ discipline.slug }}</code></td>
                        <td class="text-end pe-4"><a href="{{ path('app_admin_discipline_edit', {id: discipline.id}) }}" class="btn btn-sm btn-light border">Modifier</a></td>
                    </tr>
                {% else %}
                    <tr><td colspan="4" class="text-center text-body-secondary py-4">Aucune discipline.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
