<table role="presentation" cellpadding="0" cellspacing="0" style="width:100%;background:#f7f4ef;border-radius:8px;margin:0 0 16px;">
    <tr>
        <td style="padding:16px;font-size:14px;line-height:1.6;">
            <strong>{{ session.activity.name }}</strong><br>
            {{ session.startsAt|local_date('full')|u.title }} – {{ session.endsAt|local_date('time') }}<br>
            {{ session.studio.name }} — {{ session.studio.fullAddress }}
        </td>
    </tr>
</table>
