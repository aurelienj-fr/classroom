{% extends 'base.html.twig' %}

{% block title %}Créer un compte{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-md-9 col-lg-6">
            <div class="ms-card p-4 p-lg-5">
                <h1 class="h3 mb-1 text-center">Créer votre compte</h1>
                <p class="text-center text-body-secondary mb-4">Réservez vos cours ou publiez le planning de votre studio.</p>

                {{ form_start(form) }}
                    <div class="row g-3">
                        <div class="col-sm-6">{{ form_row(form.firstName) }}</div>
                        <div class="col-sm-6">{{ form_row(form.lastName) }}</div>
                    </div>
                    {{ form_row(form.email) }}
                    {{ form_row(form.plainPassword.first) }}
                    {{ form_row(form.plainPassword.second) }}
                    <div class="ms-card bg-primary-subtle border-0 p-3 mb-3">
                        {{ form_row(form.studioOwner, {row_attr: {class: 'mb-0'}}) }}
                    </div>
                    {{ form_row(form.agreeTerms) }}
                    <button type="submit" class="btn btn-primary btn-lg w-100">Créer mon compte</button>
                {{ form_end(form) }}

                <p class="text-center small text-body-secondary mt-4 mb-0">Déjà inscrit(e) ? <a href="{{ path('app_login') }}">Connectez-vous</a></p>
            </div>
        </div>
    </div>
{% endblock %}
