{% extends 'base.html.twig' %}

{% block title %}{{ 'nav.profile'|trans }}{% endblock %}

{% block body %}
    <h1 class="h2 mb-4">{{ 'nav.profile'|trans }}</h1>

    <div class="row g-4">
        <div class="col-lg-6">
            <section class="ms-card p-4 h-100">
                <h2 class="h5 mb-3">{{ 'profile.identity'|trans }}</h2>
                {{ form_start(profileForm) }}
                    <div class="row g-3">
                        <div class="col-sm-6">{{ form_row(profileForm.firstName) }}</div>
                        <div class="col-sm-6">{{ form_row(profileForm.lastName) }}</div>
                    </div>
                    {{ form_row(profileForm.email) }}
                    <button type="submit" class="btn btn-primary">{{ 'common.save'|trans }}</button>
                {{ form_end(profileForm) }}
            </section>
        </div>
        <div class="col-lg-6">
            <section class="ms-card p-4 h-100">
                <h2 class="h5 mb-3">{{ 'profile.password'|trans }}</h2>
                {{ form_start(passwordForm) }}
                    {{ form_row(passwordForm.currentPassword) }}
                    {{ form_row(passwordForm.newPassword.first) }}
                    {{ form_row(passwordForm.newPassword.second) }}
                    <button type="submit" class="btn btn-primary">{{ 'profile.change_password'|trans }}</button>
                {{ form_end(passwordForm) }}
            </section>
        </div>
    </div>
{% endblock %}
