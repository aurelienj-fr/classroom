{% extends 'base.html.twig' %}

{% set kind = status_code in [403, 404] ? status_code : 'generic' %}

{% block title %}{{ ('error.' ~ kind ~ '.title')|trans }}{% endblock %}

{% block body %}
    <div class="ms-card p-5 text-center mx-auto" style="max-width: 36rem">
        <div class="display-5 text-primary mb-2">{{ status_code }}</div>
        <p class="lead">{{ ('error.' ~ kind ~ '.text')|trans }}</p>
        <a href="{{ path('app_home') }}" class="btn btn-primary mt-2">{{ 'error.back_home'|trans }}</a>
    </div>
{% endblock %}
