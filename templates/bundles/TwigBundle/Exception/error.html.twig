{% extends 'base.html.twig' %}

{% block title %}{{ status_code == 404 ? 'Page introuvable' : (status_code == 403 ? 'Accès refusé' : 'Erreur') }}{% endblock %}

{% block body %}
    <div class="ms-card p-5 text-center mx-auto" style="max-width: 36rem">
        <div class="display-5 text-primary mb-2">{{ status_code }}</div>
        {% if status_code == 404 %}
            <p class="lead">Cette page n'existe pas ou n'est plus disponible.</p>
        {% elseif status_code == 403 %}
            <p class="lead">Vous n'avez pas accès à cette page.</p>
        {% else %}
            <p class="lead">Une erreur est survenue. Réessayez dans quelques instants.</p>
        {% endif %}
        <a href="{{ path('app_home') }}" class="btn btn-primary mt-2">Retour à l'accueil</a>
    </div>
{% endblock %}
