{# Remaining seats badge for a session. #}
{% macro spots(session, booked, now) %}
    {% set left = session.capacity - booked %}
    {% if session.cancelled %}
        <span class="badge text-bg-secondary">{{ 'spots.cancelled'|trans }}</span>
    {% elseif session.startsAt <= now %}
        <span class="badge text-bg-light border">{{ 'spots.finished'|trans }}</span>
    {% elseif left <= 0 %}
        <span class="badge text-bg-danger">{{ 'spots.full'|trans }}</span>
    {% elseif left <= 3 %}
        <span class="badge bg-warning-subtle text-warning-emphasis ms-spots"><i class="fa-solid fa-fire me-1" aria-hidden="true"></i>{{ 'spots.left'|trans({'%count%': left}) }}</span>
    {% else %}
        <span class="badge bg-primary-subtle text-primary ms-spots">{{ 'spots.left'|trans({'%count%': left}) }}</span>
    {% endif %}
{% endmacro %}

{% macro level(level) %}
    <span class="badge rounded-pill text-bg-light border fw-normal">{{ level|trans }}</span>
{% endmacro %}

{% macro discipline_icon(discipline) %}
    <span class="ms-icon-badge"><i class="fa-solid fa-{{ discipline.icon }}" aria-hidden="true"></i></span>
{% endmacro %}

