{% extends 'base.html.twig' %}

{% block title %}{{ activity ? 'manage.activity.edit_title'|trans ~ ' — ' ~ activity.name : 'manage.activity.new'|trans }}{% endblock %}

{% block body %}
    <nav aria-label="{{ 'common.breadcrumb'|trans }}" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a href="{{ path('app_manage_dashboard') }}">{{ 'manage.my_studios'|trans }}</a></li>
            <li class="breadcrumb-item"><a href="{{ path('app_manage_studio_show', {id: studio.id}) }}">{{ studio.name }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ activity ? activity.name : 'manage.activity.new'|trans }}</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="ms-card p-4 p-lg-5">
                <h1 class="h3 mb-4">{{ activity ? 'manage.activity.edit_title'|trans : 'manage.activity.new'|trans }}</h1>
                {{ form_start(form) }}
                    {{ form_row(form.name) }}
                    <div class="row g-3">
                        <div class="col-sm-6">{{ form_row(form.discipline) }}</div>
                        <div class="col-sm-6">{{ form_row(form.level) }}</div>
                        <div class="col-sm-6">{{ form_row(form.durationMinutes) }}</div>
                        <div class="col-sm-6">{{ form_row(form.defaultCapacity) }}</div>
                    </div>
                    {{ form_row(form.description) }}
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">{{ 'common.save'|trans }}</button>
                        <a href="{{ path('app_manage_studio_show', {id: studio.id}) }}" class="btn btn-link">{{ 'common.cancel'|trans }}</a>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}
