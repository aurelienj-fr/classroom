{% extends 'base.html.twig' %}

{% block title %}Gérer mes studios{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h2 mb-0">Mes studios</h1>
        <a href="{{ path('app_manage_studio_new') }}" class="btn btn-primary"><i class="fa-solid fa-plus me-1" aria-hidden="true"></i>Nouveau studio</a>
    </div>

    {% if studios is empty %}
        <div class="ms-card p-5 text-center">
            <i class="fa-solid fa-store fa-2x text-primary mb-3" aria-hidden="true"></i>
            <h2 class="h5">Créez votre premier studio</h2>
            <p class="text-body-secondary">Renseignez vos coordonnées et vos disciplines, puis planifiez vos cours.</p>
            <a href="{{ path('app_manage_studio_new') }}" class="btn btn-primary">Créer mon studio</a>
        </div>
    {% else %}
        <div class="row row-cols-1 row-cols-md-2 g-4">
            {% for studio in studios %}
                <div class="col">
                    <div class="ms-card p-4 h-100 d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h2 class="h5 mb-0">{{ studio.name }}</h2>
                            {% if studio.published %}
                                <span class="badge text-bg-success">Publié</span>
                            {% else %}
                                <span class="badge text-bg-secondary">Brouillon</span>
                            {% endif %}
                        </div>
                        <p class="small text-body-secondary mb-3"><i class="fa-solid fa-location-dot me-1" aria-hidden="true"></i>{{ studio.fullAddress }}</p>
                        <p class="small mb-3">{{ studio.activities|length }} cours · {{ studio.disciplines|map(d => d.name)|join(', ') }}</p>
                        <div class="mt-auto d-flex gap-2">
                            <a href="{{ path('app_manage_studio_show', {id: studio.id}) }}" class="btn btn-primary btn-sm">Planning et cours</a>
                            <a href="{{ path('app_manage_studio_edit', {id: studio.id}) }}" class="btn btn-outline-primary btn-sm">Modifier</a>
                            {% if studio.published %}
                                <a href="{{ path('app_studio_show', {slug: studio.slug}) }}" class="btn btn-link btn-sm ms-auto">Voir la page publique <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
