{% extends 'base.html.twig' %}

{% set studio = session.studio %}

{% block title %}{{ session.activity.name }} — {{ session.startsAt|local_date('day') }}{% endblock %}

{% block body %}
    <nav aria-label="{{ 'common.breadcrumb'|trans }}" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a href="{{ path('app_manage_dashboard') }}">{{ 'manage.my_studios'|trans }}</a></li>
            <li class="breadcrumb-item"><a href="{{ path('app_manage_studio_show', {id: studio.id}) }}">{{ studio.name }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ 'manage.session.breadcrumb'|trans }}</li>
        </ol>
    </nav>

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-start gap-3 mb-4">
        <div>
            <h1 class="h2 mb-1">{{ session.activity.name }}</h1>
            <p class="text-body-secondary mb-0">
                {{ session.startsAt|local_date('full')|u.title }} – {{ session.endsAt|local_date('time') }}
                {% if session.instructorName %}· {{ session.instructorName }}{% endif %}
            </p>
            {% if session.cancelled %}<span class="badge text-bg-secondary mt-2">{{ 'account.session_cancelled'|trans }}</span>{% endif %}
        </div>
        {% if not started %}
        <div class="d-flex gap-2">
            {% if not session.cancelled %}
                <a href="{{ path('app_manage_session_edit', {id: session.id}) }}" class="btn btn-outline-primary"><i class="fa-solid fa-pen me-1" aria-hidden="true"></i>{{ 'common.edit'|trans }}</a>
            {% endif %}
            <form method="post" action="{{ path('app_manage_session_toggle_cancel', {id: session.id}) }}" data-confirm="{{ session.cancelled ? 'manage.session.restore_confirm'|trans : 'manage.session.cancel_confirm'|trans }}">
                <input type="hidden" name="_token" value="{{ csrf_token('toggle-session-' ~ session.id) }}">
                {% if session.cancelled %}
                    <button type="submit" class="btn btn-outline-success"><i class="fa-solid fa-rotate-left me-1" aria-hidden="true"></i>{{ 'manage.session.restore'|trans }}</button>
                {% else %}
                    <button type="submit" class="btn btn-outline-danger"><i class="fa-solid fa-ban me-1" aria-hidden="true"></i>{{ 'manage.session.cancel'|trans }}</button>
                {% endif %}
            </form>
        </div>
        {% endif %}
    </div>

    {% if session.cancelled %}
        <div class="alert alert-secondary d-flex gap-2 align-items-center">
            <i class="fa-solid fa-circle-info" aria-hidden="true"></i>{{ 'manage.session.cancelled_info'|trans }}
        </div>
    {% endif %}

    <div class="ms-card p-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h5 mb-0">{{ 'manage.col.booked'|trans }}</h2>
            <span class="badge bg-primary-subtle text-primary">{{ attendees|length }} / {{ session.capacity }}</span>
        </div>
        {% if attendees is empty %}
            <p class="text-body-secondary mb-0">{{ 'manage.session.no_attendees'|trans }}</p>
        {% else %}
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr class="small text-body-secondary">
                            <th scope="col">{{ 'manage.col.member'|trans }}</th>
                            <th scope="col">{{ 'manage.col.email'|trans }}</th>
                            <th scope="col">{{ 'manage.col.booked_at'|trans }}</th>
                            <th scope="col" class="text-end">{{ 'manage.col.attendance'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for booking in attendees %}
                            <tr>
                                <td class="fw-semibold">{{ booking.member.fullName }}</td>
                                <td><a href="mailto:{{ booking.member.email }}">{{ booking.member.email }}</a></td>
                                <td class="small text-nowrap">{{ booking.createdAt|local_date('day_short') }} {{ booking.createdAt|local_date('time') }}</td>
                                <td class="text-end">
                                    <form method="post" action="{{ path('app_manage_booking_check_in', {id: booking.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('check-in-' ~ booking.id) }}">
                                        {% if booking.checkedInAt %}
                                            <button type="submit" class="btn btn-sm btn-success"><i class="fa-solid fa-check me-1" aria-hidden="true"></i>{{ 'account.present'|trans }}</button>
                                        {% else %}
                                            <button type="submit" class="btn btn-sm btn-light border">{{ 'manage.session.check_in'|trans }}</button>
                                        {% endif %}
                                    </form>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
{% endblock %}
