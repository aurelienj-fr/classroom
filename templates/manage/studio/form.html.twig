{% extends 'base.html.twig' %}

{% block title %}{{ studio ? 'manage.studio.edit_title'|trans ~ ' — ' ~ studio.name : 'manage.studio.new'|trans }}{% endblock %}

{% block body %}
    <nav aria-label="{{ 'common.breadcrumb'|trans }}" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a href="{{ path('app_manage_dashboard') }}">{{ 'manage.my_studios'|trans }}</a></li>
            {% if studio %}<li class="breadcrumb-item"><a href="{{ path('app_manage_studio_show', {id: studio.id}) }}">{{ studio.name }}</a></li>{% endif %}
            <li class="breadcrumb-item active" aria-current="page">{{ studio ? 'common.edit'|trans : 'manage.studio.new'|trans }}</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="ms-card p-4 p-lg-5">
                <h1 class="h3 mb-4">{{ studio ? 'manage.studio.edit_title'|trans : 'manage.studio.new'|trans }}</h1>
                {{ form_start(form) }}
                    {{ form_row(form.name) }}
                    {{ form_row(form.description) }}
                    <fieldset class="mb-3">
                        {{ form_label(form.disciplines) }}
                        <div class="row row-cols-2 row-cols-md-3">
                            {% for child in form.disciplines %}
                                <div class="col">{{ form_widget(child) }}</div>
                            {% endfor %}
                        </div>
                        {{ form_errors(form.disciplines) }}
                    </fieldset>
                    <div class="row g-3">
                        <div class="col-12">{{ form_row(form.address) }}</div>
                        <div class="col-sm-4">{{ form_row(form.postalCode) }}</div>
                        <div class="col-sm-8">{{ form_row(form.city) }}</div>
                        <div class="col-sm-6">{{ form_row(form.phone) }}</div>
                        <div class="col-sm-6">{{ form_row(form.email) }}</div>
                    </div>
                    {{ form_row(form.cancellationDeadlineHours) }}
                    <div class="ms-card bg-primary-subtle border-0 p-3 mb-4">{{ form_row(form.published, {row_attr: {class: 'mb-0'}}) }}</div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">{{ 'common.save'|trans }}</button>
                        <a href="{{ studio ? path('app_manage_studio_show', {id: studio.id}) : path('app_manage_dashboard') }}" class="btn btn-link">{{ 'common.cancel'|trans }}</a>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}
