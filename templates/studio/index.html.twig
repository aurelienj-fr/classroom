{% extends 'base.html.twig' %}

{% block title %}{{ search.ville ? 'studio.index.title_in'|trans({'%city%': search.ville}) : 'studio.index.title'|trans }}{% endblock %}

{% block body %}
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-end gap-3 mb-4">
        <div>
            <h1 class="h2 mb-1">{{ 'studio.index.heading'|trans }}</h1>
            <p class="text-body-secondary mb-0">{{ 'studio.index.count'|trans({'%count%': studios|length}) }}</p>
        </div>
        <form method="get" class="row g-2 align-items-center" role="search">
            <div class="col-sm">
                <label for="ville" class="visually-hidden">{{ 'search.city'|trans }}</label>
                <input type="text" class="form-control" id="ville" name="ville" value="{{ search.ville }}" list="cities" placeholder="{{ 'search.city'|trans }}" maxlength="100">
                <datalist id="cities">{% for city in cities %}<option value="{{ city }}">{% endfor %}</datalist>
            </div>
            <div class="col-sm">
                <label for="discipline" class="visually-hidden">{{ 'search.discipline'|trans }}</label>
                <select class="form-select" id="discipline" name="discipline">
                    <option value="">{{ 'search.all_disciplines'|trans }}</option>
                    {% for discipline in disciplines|sort((a, b) => (a|trans) <=> (b|trans)) %}
                        <option value="{{ discipline.slug }}"{{ search.discipline == discipline.slug ? ' selected' }}>{{ discipline|trans }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-sm-auto d-grid">
                <button type="submit" class="btn btn-primary"><i class="fa-solid fa-magnifying-glass me-1" aria-hidden="true"></i>{{ 'search.filter'|trans }}</button>
            </div>
        </form>
    </div>

    {% if studios is empty %}
        <div class="ms-card p-5 text-center">
            <i class="fa-regular fa-face-meh fa-2x text-body-tertiary mb-3" aria-hidden="true"></i>
            <p class="mb-3">{{ 'studio.index.empty'|trans }}</p>
            <a href="{{ path('app_studio_index') }}" class="btn btn-outline-primary">{{ 'studio.index.see_all'|trans }}</a>
        </div>
    {% else %}
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
            {% for studio in studios %}
                <div class="col">
                    <a href="{{ path('app_studio_show', {slug: studio.slug}) }}" class="ms-card d-flex flex-column h-100 p-4 text-decoration-none text-body">
                        <div class="d-flex align-items-start gap-3 mb-3">
                            <span class="ms-icon-badge"><i class="fa-solid fa-{{ studio.disciplines.first ? studio.disciplines.first.icon : 'spa' }}" aria-hidden="true"></i></span>
                            <div class="min-w-0">
                                <h2 class="h5 mb-1">{{ studio.name }}</h2>
                                <div class="small text-body-secondary"><i class="fa-solid fa-location-dot me-1" aria-hidden="true"></i>{{ studio.postalCode }} {{ studio.city }}</div>
                            </div>
                        </div>
                        {% if studio.description %}
                            <p class="small text-body-secondary mb-3">{{ studio.description|u.truncate(140, '…', false) }}</p>
                        {% endif %}
                        <div class="mt-auto d-flex flex-wrap gap-1">
                            {% for discipline in studio.disciplines %}
                                <span class="badge rounded-pill bg-primary-subtle text-primary fw-medium">{{ discipline|trans }}</span>
                            {% endfor %}
                        </div>
                    </a>
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
